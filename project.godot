; Engine configuration file.
; Open this folder in Godot 4 (Import -> select this file).

config_version=5

[application]

config/name="Spire VR Prototype"
config/description="Phase 1 proof of concept: VR sword combat against simple enemies."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Mobile")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="enemies"
3d_physics/layer_3="player_weapon"

[physics]

common/physics_ticks_per_second=90

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
openxr/startup_alert=false
shaders/enabled=true
